{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/sync/v1/:path*", "destination": "/api/sync/v1/:path*" },
    { "source": "/starter", "destination": "/" },
    { "source": "/vault/:path*", "destination": "/" }
  ]
}
